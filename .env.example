# Local SQLite database path (relative to prisma/ directory)
DATABASE_URL="file:../data/resume-sync.db"

# Local application data directory (stores resumes, history, and persistent browser profiles)
APP_DATA_DIR="./data"

# Always false by default so you can see and interact with the browser (2FA / CAPTCHA)
BROWSER_HEADLESS="false"

# Structured log level: debug | info | warn | error
LOG_LEVEL="info"

# Set to true only during automated test runs to use mock fixtures instead of live accounts
TEST_MODE="false"

# Default local portfolio repository path
PORTFOLIO_REPO_PATH="C:/Projects/react-portfolio"
